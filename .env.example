# Copiez ce fichier en ".env" et remplissez vos clés API

# https://console.anthropic.com/  -> génération du script, description, mots-clés, hashtags
ANTHROPIC_API_KEY=

# https://platform.openai.com/ -> Whisper (transcription de la vidéo source)
OPENAI_API_KEY=

# https://elevenlabs.io/ -> voix + clonage vocal + synthèse (TTS)
ELEVENLABS_API_KEY=

PORT=3000

# URL(s) du frontend autorisées à appeler cette API (séparées par des virgules).
# Exemple : https://mon-frontend.vercel.app,http://localhost:5500
# Laissez vide pour autoriser toutes les origines (déconseillé en production).
CORS_ORIGIN=
